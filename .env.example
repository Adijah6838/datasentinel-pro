# ---------- General ----------
APP_NAME=DataSentinel Pro
ENVIRONMENT=development
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# ---------- PostgreSQL ----------
POSTGRES_USER=datasentinel
POSTGRES_PASSWORD=change_me_in_real_env
POSTGRES_DB=datasentinel
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://datasentinel:change_me_in_real_env@postgres:5432/datasentinel

# ---------- Redis / Celery ----------
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ---------- Auth / security ----------
JWT_SECRET_KEY=replace_with_openssl_rand_hex_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# Fernet key for encrypting data-source credentials at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_ENCRYPTION_KEY=replace_with_generated_fernet_key

# ---------- Ports / frontend ----------
API_PORT=8000
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:8000/api/v1
VITE_WS_URL=ws://localhost:8000